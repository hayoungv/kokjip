# 데이터베이스 — Supabase
# DATABASE_URL 은 연결 모으기를 거치는 주소다 (포트 6543). 실행 중에 쓴다.
# DIRECT_URL 은 직접 연결 주소다 (포트 5432). 마이그레이션에 쓴다.
DATABASE_URL="postgresql://postgres.<프로젝트>:<비밀번호>@<지역>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<프로젝트>:<비밀번호>@<지역>.pooler.supabase.com:5432/postgres"

# 로그인 쿠키에 붙이는 서명 열쇠
# 아무 긴 문자열이면 된다. openssl rand -hex 32 로 만들 수 있다.
SESSION_SECRET=""

# 서버가 열려 있는 주소
# 강사에게 보내는 안내에 담을 주소를 만들 때 쓴다.
APP_BASE_URL="http://localhost:3000"

# 이메일 발송 — 무료 구간 서비스
# 비워 두면 보내지 않고 발급한 주소를 화면에 보여준다.
MAIL_API_KEY=""
MAIL_FROM=""

# 구글 로그인 — 2단계 앱에서 쓴다. 지금은 비워 둔다.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
